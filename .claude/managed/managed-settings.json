{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(serverless deploy*)",
      "Bash(sls deploy*)",
      "Bash(npx serverless deploy*)",
      "Bash(npx sls deploy*)",
      "Bash(sam deploy*)",
      "Bash(cdk deploy*)",
      "Bash(npx cdk deploy*)",
      "Bash(aws lambda update-function-code*)",
      "Bash(aws lambda update-function-configuration*)",
      "Bash(aws lambda publish-version*)",
      "Bash(aws cloudformation deploy*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(aws secretsmanager get-secret-value:*)"
    ]
  }
}
